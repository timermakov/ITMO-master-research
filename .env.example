# Copy to .env.local and fill values. No defaults in application code.

# Local dev values for docker-compose + benchmark from host (Windows).
# Native run without Docker: set DWSS_ZK_ENDPOINTS=127.0.0.1:2181,
# DWSS_*_HTTP_ADDR=127.0.0.1:<port>, DWSS_MMAP_FILE=data/big.bin.

# LoadedService (defaults; compose overrides ROLE / INSTANCE_ID / HTTP_ADDR)
DWSS_HTTP_ADDR=127.0.0.1:8081
DWSS_ROLE=warmup
DWSS_INSTANCE_ID=warmup-1
DWSS_MMAP_FILE=/app/data/big.bin
DWSS_MMAP_SIZE_MB=500
DWSS_INDEX_KEYS=10000
DWSS_SERVICE_NAME=loaded-service
DWSS_SHADOW_METRICS_KEEP=1000

# warmkit / ZK (warmup role)
DWSS_ZK_ENDPOINTS=zookeeper:2181
DWSS_WARMUP_READY_AFTER=100
DWSS_WARMUP_TIMEOUT_SEC=120

# docker-compose port mapping (host:container)
DWSS_ZK_CLIENT_PORT=2181
DWSS_ACTIVE_HTTP_ADDR=loaded-service-active:8080
DWSS_WARMUP_HTTP_ADDR=loaded-service-warmup:8081
DWSS_ACTIVE_HOST_PORT=8080
DWSS_WARMUP_HOST_PORT=8081
DWSS_PROXY_HOST_PORT=8090
DWSS_PROXY_CONTAINER_PORT=8090
DWSS_COORD_HOST_PORT=8091
DWSS_COORD_CONTAINER_PORT=8091
DWSS_PPROF_HOST_PORT=6060

# pprof (LoadedService warmup)
DWSS_PPROF_ENABLED=true
DWSS_PPROF_HTTP_ADDR=0.0.0.0:6060
DWSS_PPROF_PROFILE_SECONDS=30

# mirror-proxy
DWSS_PROXY_HTTP_ADDR=0.0.0.0:8090
DWSS_PROXY_ZK_ENDPOINTS=zookeeper:2181
DWSS_PROXY_SERVICE_NAME=loaded-service
DWSS_PROXY_SHUTDOWN_SEC=10

# warmup-coordinator
DWSS_COORD_HTTP_ADDR=0.0.0.0:8091
DWSS_COORD_ZK_ENDPOINTS=zookeeper:2181
DWSS_COORD_SERVICE_NAME=loaded-service
DWSS_COORD_RAMP_INTERVAL_SEC=10
DWSS_COORD_RAMP_STEPS=0,0.05,0.15,0.35,0.60,1.0
DWSS_COORD_HOLD_MAX_SEC=120
DWSS_COORD_SHUTDOWN_SEC=10

# benchmark-bench (v2) — phased load: ramp-up → steady → ramp-down
# Thesis: RAMP=60, STEADY=300 (≥5 min steady for metrics), DOWN=30; see docs/benchmark-methodology.md
# Debug: STEADY=60, RUNS=5, COOLDOWN=500
DWSS_BENCH_RUNS=10
DWSS_BENCH_MAX_RUNS=20
DWSS_BENCH_SEED=42
DWSS_BENCH_SAMPLES=1000
DWSS_BENCH_RPS=50
DWSS_BENCH_RAMP_UP_SEC=60
DWSS_BENCH_STEADY_SEC=300
DWSS_BENCH_RAMP_DOWN_SEC=30
DWSS_BENCH_H4_STEADY_SEC=120
DWSS_BENCH_CV_THRESHOLD=5
# Lab stand (Windows/Docker): 8 if CV fails at 5%
DWSS_BENCH_PROXY_URL=http://127.0.0.1:8090
DWSS_BENCH_WARMUP_URL=http://127.0.0.1:8081
DWSS_BENCH_ACTIVE_URL=http://127.0.0.1:8080
DWSS_BENCH_COORD_URL=http://127.0.0.1:8091
DWSS_BENCH_COOLDOWN_MS=1000
DWSS_BENCH_TARGET_INSTANCE=warmup-1
DWSS_BENCH_ACTIVE_INSTANCE=active-1
DWSS_BENCH_READY_AFTER=100
DWSS_BENCH_PROFILE_ON_HIGH_CV=true

# pprof UI (make profile-flame from host)
DWSS_PPROF_UI_ADDR=127.0.0.1:8082
